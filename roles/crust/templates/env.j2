# Rendered by Ansible from roles/crust/templates/env.j2: do not edit by hand on the VM.

TZ={{ crust_tz }}

POSTGRES_PASS={{ crust_postgres_password }}

# Caddy reaches nginx over the Compose network; this port is only for debugging on the VM itself.
NGINX_EXPOSE_PORT=127.0.0.1:8080
NGINX_CLIENT_MAX_BODY_SIZE={{ crust_max_attachment_size }}

# Caddy terminates TLS in front of Zammad.
NGINX_SERVER_SCHEME=https
ZAMMAD_HTTP_TYPE=https
ZAMMAD_FQDN={{ crust_fqdn }}

BACKUP_TIME={{ crust_backup_time }}
HOLD_DAYS={{ crust_backup_hold_days }}
