<VirtualHost *:80>
    ServerName {{ crust_fqdn }}
    RewriteEngine On
    RewriteRule ^/?(.*) https://{{ crust_fqdn }}/$1 [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ crust_fqdn }}
    ServerAdmin cepro-exams@epfl.ch

    ErrorLog ${APACHE_LOG_DIR}/{{ crust_fqdn | replace('.', '_') }}-error.log
    CustomLog ${APACHE_LOG_DIR}/{{ crust_fqdn | replace('.', '_') }}-access.log combined

    SSLEngine on
    SSLProtocol ALL -SSLv2 -SSLv3 -TLSv1 -TLSv1.1
    SSLCertificateKeyFile /etc/ssl/certs/crust/crust-serveur.key
    SSLCertificateFile /etc/ssl/certs/crust/{{ crust_fqdn | replace('.', '_') }}-crt.pem
{% if not (crust_tls_selfsigned | default(false)) %}
    SSLCertificateChainFile /etc/ssl/certs/crust/DigiCertCA.crt
{% endif %}

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # Zammad uses a websocket (to be tested once deployed)
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^/(.*) ws://127.0.0.1:8080/$1 [P,L]

    ProxyPass / http://127.0.0.1:8080/
    ProxyPassReverse / http://127.0.0.1:8080/
</VirtualHost>
