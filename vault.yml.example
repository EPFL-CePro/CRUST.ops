# Variables expected in group_vars/all/vault.yml. This file is only a reference:
# it holds no real value.
#
# Create the encrypted file (it asks for the vault password), then paste the keys
# below with their real values:
#
#   ansible-vault create group_vars/all/vault.yml
#
# Never commit vault.yml unencrypted.

# Generate with: openssl rand -hex 24
crust_postgres_password: "change-me"

# TLS key and certificates delivered by the IT for crust_fqdn.
# Only needed when crust_tls_selfsigned is false (see group_vars/all/app.yml).
crust_tls_key: |
  -----BEGIN PRIVATE KEY-----
  ...
  -----END PRIVATE KEY-----
crust_tls_cert: |
  -----BEGIN CERTIFICATE-----
  ...
  -----END CERTIFICATE-----
crust_tls_chain: |
  -----BEGIN CERTIFICATE-----
  ...
  -----END CERTIFICATE-----

# Only if crust_nas_backup_enabled is true.
crust_cifs_credentials: |
  username=...
  password=...
  domain=...
